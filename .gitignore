# ============================================================
# 博客仓库 .gitignore
# ============================================================

# Hugo 构建产物（由 Actions 在 CI 里生成，不入库）
public/
resources/_gen/

# Hugo 运行时锁文件
.hugo_build.lock

# 编辑器
.idea/
.vscode/
*.swp
*~

# 操作系统
.DS_Store
Thumbs.db

# 敏感信息
.env
.env.*
!.env.example

# 临时文件
*.bak
*.tmp
*.log

# ============================================================
# 本地排查用的临时产物，一律不入库
# ------------------------------------------------------------
# 这个坑踩过两次了：
#   第一次是 _shot_desktop.png 这类散落的截图文件，
#   于是加了 _shot_*.png —— 结果第二次换了目录名 _ui/ 又漏了，
#   4.3 MB 截图被 git add -A 扫进仓库。
#
# 所以规则改成按【前缀】一刀切，而不是按具体文件名。
#
# 注意：不能写成 `_*`，那会把 Hugo 的 _index.md 一起忽略掉，
# 整个站点的栏目页会全部消失。必须用 `_*/` 只匹配目录。
# ============================================================
_*/
_shot_*.png

# 例外：layouts/_default/ 是 Hugo 的模板查找目录（不是临时目录），
# 上面的 `_*/` 会把它一起忽略掉 —— 结果是 CI 构建时找不到 single/list 模板。
# 2026-10-12 前端改版时踩到（本地能构建，Actions 上会失败），这里显式放行。
!layouts/_default/

# 端侧实验/取证产物：绝不进仓库（防止 git add -A 误提交）
docs/demo-assets/
_shots/
_dev/

# _*/ 会连目录一起忽略，所以先把 _dev/ 放回来、再按文件白名单（5 个：2 个门禁 + 3 个素材生成链）
!_dev/
_dev/*
!_dev/gate-firstscreen.mjs
!_dev/check-ssr-contract.py
!_dev/build_statemachine_manifest.py
!_dev/build_voice_bank.py
!_dev/build_mouth_data.py

!_dev/gen-demo-pages.py

# T7 视频接线工装（窗口 C，2026-10-15 批准入库）
!_dev/build_video_manifest.py
!_dev/check-video-align.py
!_dev/verify-video-wiring.mjs
!_dev/t7-baseline-shot.mjs
!_dev/_t7-pixeldiff.py

# T8 状态机工装（窗口 C，2026-10-15 批准入库）
!_dev/verify-sm-walker.mjs
!_dev/refresh_manifest_voice.py

# 窗口 Q 站点接手批（2026-10-15 批准入库）：首屏 initiator 取证 / 开场六阶段逐帧取证
!_dev/probe-firstscreen-initiator.mjs
!_dev/probe-boot-phases.mjs

# 外部审查接手批（窗口 R，2026-10-16）：事实快照 / 资产引用完整性(第四道门禁候选) / 布局静态审计
!_dev/snapshot-facts.py
!_dev/check-asset-integrity.py
!_dev/audit-layout-static.py
# 站点线批次 A 的取证脚本与机器可读报告（规划侧 2026-10-16 批准入库）
!_dev/shot-batch-a.mjs
!_dev/firstscreen-order.mjs
!_dev/_probe-idcard.mjs
!_shots/batchA-shot-report.json
!_shots/batchA2-shot-report.json
!_shots/firstscreen-order-home.json!_dev/shot-batch-b-askbar.mjs
