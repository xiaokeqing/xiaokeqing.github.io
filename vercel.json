{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify --cleanDestinationDir",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.167.0",
      "HUGO_ENV": "production",
      "TZ": "Asia/Shanghai"
    }
  },
  "redirects": [
    {
      "source": "/alerts",
      "destination": "/hud/",
      "permanent": true
    },
    {
      "source": "/alerts/(.*)",
      "destination": "/hud/",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/intel/",
      "permanent": true
    },
    {
      "source": "/tools/",
      "destination": "/intel/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/ip.js",
      "destination": "https://demo.xiaokeqing.cn/api/public/ip.js"
    },
    {
      "source": "/api/public/story.js",
      "destination": "https://demo.xiaokeqing.cn/api/public/story.js"
    },
    {
      "source": "/api/public/audit.js",
      "destination": "https://demo.xiaokeqing.cn/api/public/audit.js"
    },
    {
      "source": "/api/public/ask",
      "destination": "https://demo.xiaokeqing.cn/api/public/ask"
    },
    {
      "source": "/api/user/(.*)",
      "destination": "https://demo.xiaokeqing.cn/api/user/$1"
    },
    {
      "source": "/api/health",
      "destination": "https://demo.xiaokeqing.cn/api/health"
    },
    {
      "source": "/api/public/daily.js",
      "destination": "https://demo.xiaokeqing.cn/api/public/daily.js"
    },
    {
      "source": "/api/public/daily/(.*)",
      "destination": "https://demo.xiaokeqing.cn/api/public/daily/$1"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/kurisu/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://demo.xiaokeqing.cn; connect-src 'self' https://demo.xiaokeqing.cn; font-src 'self' data:; media-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
